# Copy this file to ".env" and edit the copy:   cp .env.example .env
# Every setting is optional - the app runs fine with no .env file at all.

# ---------------------------------------------------------------------------
# AI wording (optional)
# ---------------------------------------------------------------------------
# Leave the key empty to use "template mode": free, offline, no account needed.
# Add a key from https://console.anthropic.com to let Claude write the wording of
# ordinary answers (prices, timings, doctors, FAQs). Emergencies, complaints, medical
# questions and appointment requests always use safe templates, never the model.
ANTHROPIC_API_KEY=

# Which Claude model to use when a key is set. claude-haiku-5-5 is the cheapest option.
CLAUDE_MODEL=claude-opus-5-5

# ---------------------------------------------------------------------------
# Safety rules
# ---------------------------------------------------------------------------
# Start with automatic replies on (true) or off (false). The dashboard has a switch too.
AUTO_REPLY_ENABLED=true

# true = EVERY answer written by the AI model waits for a receptionist, even if all checks pass.
# A cautious setting for the first weeks with a real API key. Template answers are unaffected.
APPROVE_MODEL_ANSWERS=false

# Below this topic-confidence (0 to 1) a receptionist must approve the reply.
MIN_CLASSIFIER_CONFIDENCE=0.7

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Where chats are stored (a single SQLite file). Relative paths start at the project folder.
DATABASE_PATH=clinic_ai.db

# Used only for the "time saved" estimate on the dashboard.
MINUTES_SAVED_PER_AUTO_REPLY=2

# ---------------------------------------------------------------------------
# WhatsApp
# ---------------------------------------------------------------------------
# simulated = the demo chat page imitates WhatsApp; no Meta account needed (default)
# cloud     = the official Meta WhatsApp Cloud API: REAL patients and REAL messages
# Setup guide: documentation/WHATSAPP_CLOUD_SETUP.md
WHATSAPP_MODE=simulated

# --- Only needed when WHATSAPP_MODE=cloud. These are SECRETS: keep them in .env (never committed) ---
# A string YOU invent (e.g. a long random phrase). Paste the same text into Meta's "Verify token" box.
WHATSAPP_VERIFY_TOKEN=
# Meta app dashboard > App settings > Basic > App secret. Used to check that webhooks really come from Meta.
WHATSAPP_APP_SECRET=
# Meta app dashboard > WhatsApp > API Setup > Temporary access token (24 hours) - or a permanent System User token.
WHATSAPP_ACCESS_TOKEN=
# Meta app dashboard > WhatsApp > API Setup > "Phone number ID" (a long number; NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# --- Optional ---
# Graph API version. Any version Meta currently supports works (see developers.facebook.com/docs/graph-api/changelog).
WHATSAPP_GRAPH_API_VERSION=v25.0
# While testing: only process messages from these numbers (digits only, comma separated). Empty = everyone.
WHATSAPP_ALLOWED_SENDERS=
# The dashboard has no login. Requests that arrive through a tunnel are blocked except the webhook.
# true removes that protection - do not use it unless you understand the risk.
ALLOW_PUBLIC_DASHBOARD=false
